# ==============================================================================
# AUTOMA SOCIAL MEDIA PUBLISHING SYSTEM — CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Never commit '.env' to version control.
# ==============================================================================

# Operation Mode
# Set to 'true' to simulate generation, validation, and publishing without making live external social API calls.
# Set to 'false' only after verifying your integrations and brand knowledge.
DRY_RUN=false
ENVIRONMENT=development
TIMEZONE=UTC

# ------------------------------------------------------------------------------
# Reasoning & Content Generation (Gemini)
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Publishing Engine
# ------------------------------------------------------------------------------
# Supported values: 'dry_run', 'postiz', 'direct'
# - 'dry_run': Simulates all API calls, writes formatted post JSON to content/published/
# - 'postiz': Uses Postiz REST API (/public/v1/posts) to schedule or publish
# - 'direct': Uses direct platform APIs (LinkedIn Community API, Twitter v2, Instagram Graph)
PUBLISHER_TYPE=direct

# Postiz Configuration (If PUBLISHER_TYPE=postiz)
# For Postiz Cloud: https://api.postiz.com/public/v1
# For Self-Hosted Postiz: http://localhost:3000/api/public/v1 (or your custom domain)
POSTIZ_BASE_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=your_postiz_api_key_here
POSTIZ_LINKEDIN_INTEGRATION_ID=
POSTIZ_X_INTEGRATION_ID=
POSTIZ_INSTAGRAM_INTEGRATION_ID=

# Direct Platform Credentials (Optional: if PUBLISHER_TYPE=direct)
# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# X (Twitter) API v2
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Instagram Graph API (Requires Facebook Page connected to IG Professional Account)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# Notification & Alerting
# ------------------------------------------------------------------------------
# Webhook URL for urgent alerts (Discord / Slack / Telegram webhook)
# Alerts are fired ONLY when action is needed:
# - Auth / token expiration
# - Repeated post failures (max retries exhausted)
# - High-risk drafts requiring manual review
# - Queue empty or service unhealthy
NOTIFICATION_WEBHOOK_URL=
NOTIFY_ON_FAILURE=true
NOTIFY_ON_REVIEW_NEEDED=true
NOTIFY_ON_SUCCESS=false

# ------------------------------------------------------------------------------
# Local Monitoring Dashboard
# ------------------------------------------------------------------------------
# Binds strictly to localhost for security
WEB_HOST=127.0.0.1
WEB_PORT=8080
