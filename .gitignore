# Python virtual environment & cache
.venv/
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Local databases & storage
*.db
*.db-journal
*.db-wal
*.db-shm
data/*.db

# Credentials & environment
.env
.env.local
tokens.json
secrets.json

# Local logs & runs
logs/*.log
logs/*.jsonl
data/*.log
data/*.lock
.tunnel_info.json

# Binaries
bin/

# Generated content artifacts & queues
content/published/*
content/rejected/*
content/queue/*
content/media/*
!content/published/.gitkeep
!content/rejected/.gitkeep
!content/queue/.gitkeep
!content/media/.gitkeep
